{
  "name": "@mukundakatta/streamparse-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing streamparse: parse partial / truncated JSON, extract JSON from messy LLM output, validate JSON streams. Built for Claude Desktop, Cursor, Cline, Windsurf, and Zed.",
  "type": "module",
  "bin": {
    "mcp-streamparse": "dist/server.js"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "cline",
    "windsurf",
    "zed",
    "json",
    "streaming",
    "partial",
    "llm",
    "tool-calls"
  ],
  "author": "Mukunda Katta <mukunda.vjcs6@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/MukundaKatta/streamparse-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MukundaKatta/streamparse-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mukundakatta/streamparse": "file:../streamparse"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
